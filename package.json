{
  "name": "barbershop-platform",
  "version": "2.0.0",
  "description": "Barbershop website with online booking, a business profile and an owner area.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && tsc -p client/tsconfig.json --noEmit && vite build",
    "start": "node dist/server.js",
    "db:migrate": "node dist/db/migrar.js",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "simulate": "node scripts/simulate-agents.mjs",
    "shop": "node dist/scripts/shop.js",
    "banners": "node scripts/build-banners.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "express": "^5.1.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.5"
  }
}

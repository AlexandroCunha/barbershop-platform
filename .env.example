# Copy to .env and fill in. Never commit .env.

PORT=3100
DATABASE_URL=postgres://barbearia:barbearia@localhost:5434/barbearia

# Owner area access token. At least 24 characters. Leave empty to keep /admin closed.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Send the owner session cookie only over HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# Set to true only when a reverse proxy in front of the site sets X-Forwarded-For.
# TRUST_PROXY=true

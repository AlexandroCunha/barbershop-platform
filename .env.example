# Copy to .env and fill in. Never commit .env.

PORT=3100
DATABASE_URL=postgres://barbearia:barbearia@localhost:5434/barbearia

# Signs owner and platform sessions. At least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Developer accounts for /platform are created with: npm run developer:create -- you@example.com

# Send session cookies only over HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# Number of reverse proxies in front of the app: 1 behind one proxy, unset when none.
# Never set it without a proxy, or clients can forge their address. See docs/DEPLOY.md.
# TRUST_PROXY=1

# Where photos are kept: "local" (this server's disk) or "s3" (an S3-compatible bucket, such as R2).
# MEDIA_STORAGE=local
# S3_BUCKET=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Barbershop the home page opens. Defaults to the first barbershop created.
# HOME_SHOP_SLUG=northgate

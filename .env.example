# Copy to .env and fill in. Never commit .env.

PORT=3100
DATABASE_URL=postgres://barbearia:barbearia@localhost:5434/barbearia

# Signs owner and platform sessions. At least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Platform owner's token for /platform. At least 24 characters. Leave empty to keep /platform closed.
PLATFORM_ADMIN_TOKEN=

# Send session cookies only over HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# Set to true only when a reverse proxy in front of the site sets X-Forwarded-For.
# TRUST_PROXY=true
